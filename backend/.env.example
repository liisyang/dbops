# Database Configuration
POSTGRES_HOST=0.0.0.0  # 开发环境 My/PostgreSQL 地址，部署时改为实际 IP
POSTGRES_PORT=5432
POSTGRES_DB=dbops
POSTGRES_USER=dbops
POSTGRES_PASSWORD=db20240910

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Redis
REDIS_URL=redis://0.0.0.0:6379/0  # 开发环境 Redis 地址，部署时改为实际 IP

# SSH (for Ansible operations)
SSH_USER=dbaacc
SSH_PASSWORD=
SSH_KEY=~/.ssh/id_ed25519
SSH_USER_GROUP=dba
SSH_USER_HOME_PREFIX=/home
SSH_PROFILE_PATH=/home
SSH_PORT=22
SSH_TIMEOUT=30

# Ansible
ANSIBLE_TIMEOUT=10
ANSIBLE_FORKS=20

# Host Check
HOST_CHECK_INTERVAL=600

# CORS (comma-separated list of origins, empty for same-origin only)
CORS_ORIGINS=

# =============================================================================
# AI Copilot 配置（Phase 3.6）— 按 plan §15 环境启用顺序灰度开启
# =============================================================================
# 5 个独立功能开关
AI_CHAT_ENABLED=false
AI_SQL_PREVIEW_ENABLED=false
AI_SQL_EXECUTION_ENABLED=false
AI_REPORT_ANALYSIS_ENABLED=false
AI_REPORT_EXPORT_AI_ENABLED=false

# Dify 服务（3 个独立 app + base_url）
# 部署时改为实际 Dify 服务地址；API Key 在 .env 配置（绝不入代码/日志/git）
DIFY_BASE_URL=
DIFY_CHAT_API_KEY=
DIFY_SQL_WORKFLOW_KEY=
DIFY_REPORT_WORKFLOW_KEY=

# 4 个独立超时（秒）
DIFY_CONNECT_TIMEOUT_SECONDS=10
DIFY_CHAT_TIMEOUT_SECONDS=60
DIFY_SQL_TIMEOUT_SECONDS=60
DIFY_REPORT_TIMEOUT_SECONDS=120

# Dify Workflow 版本号（用作分析缓存键之一）
DIFY_SQL_WORKFLOW_VERSION=2026-06-27-v1
DIFY_REPORT_WORKFLOW_VERSION=2026-06-27-v1

# Schema Snapshot 限制（Phase 3.6B0）
AI_SCHEMA_SNAPSHOT_TTL_HOURS=24
AI_SCHEMA_CONTEXT_MAX_CHARS=30000
AI_SCHEMA_MAX_TABLES=100
AI_SCHEMA_MAX_COLUMNS_PER_TABLE=100
AI_SCHEMA_COLLECTION_TIMEOUT_SECONDS=300
AI_SCHEMA_RESULT_MAX_ROWS=20000
AI_SCHEMA_RESULT_MAX_BYTES=10485760

# SQL 执行结果限制（Phase 3.6B1/B2）
AI_SQL_RESULT_MAX_ROWS=200
AI_SQL_RESULT_MAX_COLUMNS=100
AI_SQL_RESULT_MAX_CELL_CHARS=4000
AI_SQL_RESULT_MAX_BYTES=2097152
